@@ -9,6 +9,20 @@ namespace LibOrbisPkg.Util
 {
   internal static class StreamExtensions
   {
+    /// <summary>Read exactly count bytes (or until end of stream). Stream.Read may return
+    /// fewer bytes than requested; since .NET 6 DeflateStream and CryptoStream do.</summary>
+    public static int ReadFully(this Stream s, byte[] buffer, int offset, int count)
+    {
+      int total = 0;
+      while (count > 0)
+      {
+        int n = s.Read(buffer, offset, count);
+        if (n <= 0) break;
+        offset += n; count -= n; total += n;
+      }
+      return total;
+    }
+
